# ══════════════════════════════════════════════════════════════════════════════
# SECURITY RULES — READ BEFORE EDITING
# ══════════════════════════════════════════════════════════════════════════════
#
# NEXT_PUBLIC_ prefix = bundled into client-side JS = visible to ALL users
# NO prefix           = server-side only = never visible to users
#
# Supabase credentials have NO NEXT_PUBLIC_ prefix — they are server-side only.
# Tenants must never see any Supabase URL, key, or error message.
# If you are unsure, do NOT add NEXT_PUBLIC_ to any variable.
#
# Only two variables are intentionally NEXT_PUBLIC_:
#   - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  (Stripe requires a public key for checkout)
#   - NEXT_PUBLIC_VAPI_PUBLIC_KEY         (Vapi requires a public key for web calls)
# These are "publishable" by design — safe to expose. All secret keys stay server-side.
#
# ══════════════════════════════════════════════════════════════════════════════

# ─── SUPABASE (server-side only — NO NEXT_PUBLIC_) ────────────────────────────
# Configure in Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── DATABASE (Supabase PostgreSQL — server-side only) ────────────────────────
# Configure in Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── VAPI ─────────────────────────────────────────────────────────────────────
# Private key: server-side only. Public key: used by Vapi web SDK for test calls.
VAPI_API_KEY=your-vapi-private-key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Secret key: server-side only. Publishable key: used by Stripe.js for checkout.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── RESEND (email — server-side only) ────────────────────────────────────────
# Must use hiastrix.com domain — configure in Resend Dashboard → Domains
# Also configure Supabase custom SMTP to use Resend so auth emails
# come from hiastrix.com, not mail.supabase.io
RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@hiastrix.com

# ─── APP ──────────────────────────────────────────────────────────────────────
APP_URL=https://app.hiastrix.com
APP_SECRET=generate-with-openssl-rand-base64-32

# ─── SUPABASE AUTH CONFIGURATION (do in Supabase Dashboard, not here) ─────────
# These settings must be configured manually in Supabase Dashboard:
#
# 1. Auth → URL Configuration → Site URL:
#      https://app.hiastrix.com
#
# 2. Auth → URL Configuration → Redirect URLs (add all of these):
#      https://app.hiastrix.com/auth/callback
#      https://app.hiastrix.com/auth/callback?next=/dashboard
#      https://app.hiastrix.com/auth/callback?next=/auth/update-password
#
# 3. Auth → SMTP Settings → Enable Custom SMTP:
#      Host: smtp.resend.com
#      Port: 465
#      User: resend
#      Password: [your Resend API key]
#      Sender email: no-reply@hiastrix.com
#      Sender name: Astrix
#
# 4. Auth → Email Templates:
#      Customise all templates — remove any Supabase branding.
#      Confirmation URL variable: {{ .ConfirmationURL }}
#      (Supabase replaces this with your Redirect URL + token)
