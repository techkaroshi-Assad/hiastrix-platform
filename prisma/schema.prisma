// Prisma schema for Hi-Astrix.
//
// The database was created from hand-written SQL using Postgres conventions:
// snake_case columns, snake_case enum types, uuid primary keys and timestamptz
// timestamps. The models below keep idiomatic camelCase TypeScript names and
// bridge to those columns with @map / @@map, so application code is unchanged.
//
// Every scalar field carries an explicit @map where the column name differs,
// every uuid column is @db.Uuid, and every timestamp is @db.Timestamptz(6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── PACKAGES ────────────────────────────────────────────────────────────────

model Package {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  minutesIncluded    Int      @map("minutes_included")
  priceCents         Int      @map("price_cents")          // USD cents
  overageRateCents   Int      @map("overage_rate_cents")   // per minute, USD cents
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenants            Tenant[]

  @@map("packages")
}

// ─── TENANTS ─────────────────────────────────────────────────────────────────

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  companyName        String       @map("company_name")
  email              String       @unique
  status             TenantStatus @default(PENDING)
  stripeCustomerId   String?      @map("stripe_customer_id")
  packageId          String?      @map("package_id") @db.Uuid
  packageAssignedAt  DateTime?    @map("package_assigned_at") @db.Timestamptz(6)
  minutesUsed        Int          @default(0) @map("minutes_used")
  creditBalanceCents Int          @default(0) @map("credit_balance_cents") // USD cents
  /// Which CRM sub-account this tenant's agents act on. Null until an operator
  /// maps one, which is also the signal the agent builder uses to hide the CRM
  /// tools rather than show dropdowns with nothing in them.
  crmLocationId      String?      @map("crm_location_id")
  /// Per-tenant outbound concurrency. Null falls back to the platform default.
  maxConcurrentCalls Int?         @map("max_concurrent_calls")
  /// Dialling code used to normalise bare numbers in an uploaded lead list.
  defaultCountryCode String       @default("1") @map("default_country_code")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  package            Package?       @relation(fields: [packageId], references: [id])
  users              TenantUser[]
  agents             Agent[]
  phoneNumbers       PhoneNumber[]
  calls              Call[]
  creditLedger       CreditLedger[]
  payments           Payment[]
  invitations        TenantInvitation[]
  campaigns          Campaign[]
  campaignLeads      CampaignLead[]
  dialAttempts       DialAttempt[]
  suppressions       Suppression[]

  @@map("tenants")
}

enum TenantStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("tenant_status")
}

// ─── TENANT USERS ─────────────────────────────────────────────────────────────

model TenantUser {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  supabaseId   String         @unique @map("supabase_id") @db.Uuid // auth.users id
  email        String         @unique
  name         String
  type         TenantUserType
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_users")
}

enum TenantUserType {
  OWNER
  ACCOUNT_MANAGER

  @@map("tenant_user_type")
}

// ─── INVITATIONS ──────────────────────────────────────────────────────────────
// Owners inviting their own staff. Accepting produces a normal TenantUser row.

model TenantInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  email      String
  name       String
  type       TenantUserType   @default(ACCOUNT_MANAGER)
  /// sha256 of the invite token. The token itself is never stored.
  tokenHash  String           @unique @map("token_hash")
  invitedBy  String?          @map("invited_by")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

// ─── ADMIN USERS ─────────────────────────────────────────────────────────────

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  supabaseId  String    @unique @map("supabase_id") @db.Uuid // auth.users id
  email       String    @unique
  name        String
  role        AdminRole
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN

  @@map("admin_role")
}

// ─── AGENTS ──────────────────────────────────────────────────────────────────

model Agent {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  vapiAssistantId      String        @unique @map("vapi_assistant_id")
  name                 String
  status               AgentStatus   @default(ACTIVE)
  voice                String?
  model                String?
  systemPrompt         String?       @map("system_prompt")
  firstMessage         String?       @map("first_message")
  recordingEnabled     Boolean       @default(true) @map("recording_enabled")
  transcriptionEnabled Boolean       @default(true) @map("transcription_enabled")
  /// Extended Vapi options — see lib/vapi/config.ts. Server-side only.
  config               Json          @default("{}")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumbers         PhoneNumber[]
  calls                Call[]
  campaigns            Campaign[]

  @@map("agents")
}

enum AgentStatus {
  ACTIVE
  INACTIVE

  @@map("agent_status")
}

// ─── PHONE NUMBERS ────────────────────────────────────────────────────────────

model PhoneNumber {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String?     @map("tenant_id") @db.Uuid // null = unallocated
  agentId           String?     @map("agent_id") @db.Uuid  // null = unassigned
  vapiPhoneNumberId String      @unique @map("vapi_phone_number_id")
  phoneNumber       String      @map("phone_number")
  status            PhoneStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agent             Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  calls             Call[]
  campaigns         Campaign[]
  dialAttempts      DialAttempt[]

  @@map("phone_numbers")
}

enum PhoneStatus {
  ACTIVE
  INACTIVE

  @@map("phone_status")
}

// ─── CALLS ───────────────────────────────────────────────────────────────────

model Call {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  agentId         String?       @map("agent_id") @db.Uuid
  phoneNumberId   String?       @map("phone_number_id") @db.Uuid
  vapiCallId      String        @unique @map("vapi_call_id")
  direction       CallDirection
  callerNumber    String?       @map("caller_number")
  durationSeconds Int           @default(0) @map("duration_seconds")
  minutesBilled   Int           @default(0) @map("minutes_billed") // ceiling of duration
  costCents       Int           @default(0) @map("cost_cents")     // USD cents
  status          CallStatus
  recordingUrl    String?       @map("recording_url")
  transcript      String?
  /// Model-written summary from the end-of-call report.
  summary         String?
  /// Why the call ended, verbatim from the provider.
  endedReason     String?       @map("ended_reason")
  /// Structured data extraction and success evaluation.
  analysis        Json?
  /// Turn-by-turn transcript with roles and timings.
  messages        Json?
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  agent           Agent?        @relation(fields: [agentId], references: [id])
  phoneNumber     PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])

  @@map("calls")
}

enum CallDirection {
  INBOUND
  OUTBOUND
  WEB

  @@map("call_direction")
}

enum CallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY

  @@map("call_status")
}

// ─── CREDIT LEDGER ────────────────────────────────────────────────────────────

model CreditLedger {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  type        LedgerEntryType
  amountCents Int             @map("amount_cents") // positive = credit, negative = debit
  description String?         // tenant-facing note — never contains staff identity
  referenceId String?         @map("reference_id") @db.Uuid // call id or payment id
  createdBy   String?         @map("created_by") // operator email; admin UI only
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id])

  @@map("credit_ledger")
}

enum LedgerEntryType {
  PACKAGE_PURCHASE
  TOP_UP
  CALL_DEDUCTION
  OVERAGE_CHARGE
  MANUAL_CREDIT
  MANUAL_DEDUCTION

  @@map("ledger_entry_type")
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  amountCents           Int           @map("amount_cents") // USD cents
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                Tenant        @relation(fields: [tenantId], references: [id])

  @@map("payments")
}

enum PaymentType {
  PACKAGE_PURCHASE
  TOP_UP

  @@map("payment_type")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("payment_status")
}

// ─── PLATFORM SETTINGS ────────────────────────────────────────────────────────
// Exactly one row, guarded by a boolean primary key with a CHECK constraint.

/// The one agency-wide CRM connection.
///
/// Single row, same trick as PlatformSettings: a boolean primary key that can
/// only ever be true. Unlike every other vendor credential in this codebase these
/// tokens rotate at runtime, so they cannot live in the environment — this table
/// is the one place the platform stores a live secret.
model CrmConnection {
  id           Boolean  @id @default(true)
  companyId    String   @map("company_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  connectedBy  String?  @map("connected_by")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("crm_connection")
}

model PlatformSettings {
  id               Boolean  @id @default(true)
  overageRateCents Int      @default(35) @map("overage_rate_cents")
  lowBalancePct    Int      @default(20) @map("low_balance_pct")
  supportEmail     String   @default("support@hiastrix.com") @map("support_email")

  // ── Outbound dialler ──────────────────────────────────────────────────
  /// The 2am switch. False stops every claim on the platform at once.
  dialerEnabled       Boolean @default(true) @map("dialer_enabled")
  /// Platform-wide live outbound calls. Set to ~85% of the provider's own
  /// limit: this tier is bounded best-effort rather than exact, and the
  /// headroom absorbs the slack. See lib/dialer/claim.ts.
  maxConcurrentCalls  Int     @default(40)  @map("max_concurrent_calls")
  /// Default per-tenant cap, overridable on the tenant.
  tenantMaxConcurrent Int     @default(10)  @map("tenant_max_concurrent")
  /// Calls one number may place in 24h before it drops out of rotation —
  /// carriers spam-label a number that dials all day.
  numberDailyCallCap  Int     @default(200) @map("number_daily_call_cap")
  /// Times one person may be dialled in 24h across all of a tenant's campaigns.
  contactDailyCap     Int     @default(2)   @map("contact_daily_cap")
  /// Forced into the system prompt of any agent running a campaign, the same
  /// way the CRM rules are, so a tenant cannot edit it out.
  consentLine         String  @default("Let the person know this call may be recorded, in your first sentence, before anything else.") @map("consent_line")

  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?  @map("updated_by")

  @@map("platform_settings")
}

// ─── OUTBOUND CAMPAIGNS ───────────────────────────────────────────────────────
// The dialler. Its moving parts are documented in lib/dialer/, and the reasoning
// behind the table split is in sql/2026-07-28-dialer.sql.

model Campaign {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  agentId          String        @map("agent_id") @db.Uuid
  /// Null rotates round-robin across every number attached to the agent, which
  /// is what keeps one caller ID from being spam-labelled. Set it only when a
  /// campaign must always present the same number.
  phoneNumberId    String?       @map("phone_number_id") @db.Uuid

  name             String
  state            CampaignState @default(DRAFT)
  source           LeadSource    @default(CSV)
  /// For a CRM_TAG campaign, the tag it was pulled from. Kept for the record —
  /// the lead set is snapshotted at creation and never re-read.
  sourceRef        String?       @map("source_ref")

  maxConcurrent    Int           @default(3) @map("max_concurrent")
  maxAttempts      Int           @default(3) @map("max_attempts")

  /// Calling window, in the campaign's own timezone. Enforced inside the claim
  /// statement, so no code path can dial around it.
  timezone         String        @default("America/New_York")
  windowStart      String        @default("09:00") @map("window_start")
  windowEnd        String        @default("19:00") @map("window_end")
  /// ISO day of week, Monday = 1.
  windowDays       Int[]         @default([1, 2, 3, 4, 5]) @map("window_days")

  voicemailPolicy  VoicemailPolicy @default(HANG_UP_RETRY) @map("voicemail_policy")
  voicemailMessage String?         @map("voicemail_message")

  /// Set on a provider 429. The claim refuses while it is in the future, so a
  /// throttled campaign stops without any in-memory state.
  throttledUntil   DateTime?     @map("throttled_until") @db.Timestamptz(6)
  /// Round-robin fairness across campaigns within one heartbeat tick.
  lastTickedAt     DateTime?     @map("last_ticked_at") @db.Timestamptz(6)

  pausedReason     String?       @map("paused_reason")
  createdBy        String?       @map("created_by")
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  phoneNumber      PhoneNumber?  @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  leads            CampaignLead[]
  attempts         DialAttempt[]

  @@map("campaigns")
}

enum CampaignState {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED

  @@map("campaign_state")
}

enum LeadSource {
  CSV
  CRM_TAG
  MANUAL

  @@map("lead_source")
}

enum VoicemailPolicy {
  LEAVE_MESSAGE
  HANG_UP_RETRY
  HANG_UP_DONE

  @@map("voicemail_policy")
}

/// The queue. One row per person per campaign, reused across retries.
///
/// This is also where outbound concurrency is counted from — the claim statement
/// is what moves a row to DIALING, so the count and the claim are the same
/// statement and there is no window between them.
model CampaignLead {
  id              String     @id @default(uuid()) @db.Uuid
  campaignId      String     @map("campaign_id") @db.Uuid
  /// Denormalised so the per-tenant concurrency count and the contact-frequency
  /// cap never need a join.
  tenantId        String     @map("tenant_id") @db.Uuid

  phoneE164       String     @map("phone_e164")
  contactName     String?    @map("contact_name")
  crmContactId    String?    @map("crm_contact_id")
  /// Merge values for the agent's opening line. Server-side only.
  fields          Json       @default("{}")

  priority        Int        @default(0) @db.SmallInt
  state           LeadState  @default(PENDING)

  /// Two budgets, deliberately separate. A provider fault spends `faultNo`, not
  /// `attemptNo`, so an outage cannot quietly burn a whole list's real attempts.
  attemptNo       Int        @default(0) @map("attempt_no")
  faultNo         Int        @default(0) @map("fault_no")

  nextAttemptAt   DateTime   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseExpiresAt  DateTime?  @map("lease_expires_at") @db.Timestamptz(6)
  lastOutcome     String?    @map("last_outcome")
  /// Why this lead ended where it did, in words a tenant can read.
  note            String?

  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign        Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempts        DialAttempt[]

  @@unique([campaignId, phoneE164])
  @@map("campaign_leads")
}

enum LeadState {
  PENDING
  RETRY_WAIT
  DEFERRED
  DIALING
  IN_PROGRESS
  COMPLETED
  EXHAUSTED
  FAILED
  SUPPRESSED
  CANCELLED

  @@map("lead_state")
}

/// The ledger. One row per dial, written BEFORE the provider is called.
///
/// That ordering is what makes a lost create-response recoverable: a row with no
/// provider call id means "we may have dialled this person and we do not know",
/// which the reaper can resolve. It also makes the partial unique index on
/// (tenantId, phoneE164) a real guard — a second campaign dialling the same
/// person while a call is live is rejected by the database before it can reach
/// the provider.
model DialAttempt {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  campaignId      String        @map("campaign_id") @db.Uuid
  campaignLeadId  String        @map("campaign_lead_id") @db.Uuid

  attemptNo       Int           @map("attempt_no")
  phoneE164       String        @map("phone_e164")
  /// Which of the agent's numbers presented as caller ID, for the per-number
  /// daily volume cap.
  phoneNumberId   String?       @map("phone_number_id") @db.Uuid

  /// Null only while PLACING, or permanently when LOST.
  providerCallId  String?       @map("provider_call_id")
  state           AttemptState  @default(PLACING)
  leaseExpiresAt  DateTime      @map("lease_expires_at") @db.Timestamptz(6)

  endedReason     String?       @map("ended_reason")
  durationSeconds Int           @default(0) @map("duration_seconds")
  /// Server-side only. Never rendered to a tenant.
  error           String?

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            CampaignLead  @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  phoneNumber     PhoneNumber?  @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  @@map("dial_attempts")
}

enum AttemptState {
  PLACING
  DIALING
  IN_PROGRESS
  RECONCILING
  ENDED
  LOST

  @@map("attempt_state")
}

/// Do not call. Checked at import and again before every dial.
model Suppression {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  phoneE164  String            @map("phone_e164")
  source     SuppressionSource @default(MANUAL)
  note       String?
  createdBy  String?           @map("created_by")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneE164])
  @@map("suppressions")
}

enum SuppressionSource {
  UPLOAD
  MANUAL
  CALLER_REQUEST

  @@map("suppression_source")
}
