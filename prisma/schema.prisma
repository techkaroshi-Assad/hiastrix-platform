// Prisma schema for Hi-Astrix.
//
// The database was created from hand-written SQL using Postgres conventions:
// snake_case columns, snake_case enum types, uuid primary keys and timestamptz
// timestamps. The models below keep idiomatic camelCase TypeScript names and
// bridge to those columns with @map / @@map, so application code is unchanged.
//
// Every scalar field carries an explicit @map where the column name differs,
// every uuid column is @db.Uuid, and every timestamp is @db.Timestamptz(6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── PACKAGES ────────────────────────────────────────────────────────────────

model Package {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  minutesIncluded    Int      @map("minutes_included")
  priceCents         Int      @map("price_cents")          // USD cents
  overageRateCents   Int      @map("overage_rate_cents")   // per minute, USD cents
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenants            Tenant[]

  @@map("packages")
}

// ─── TENANTS ─────────────────────────────────────────────────────────────────

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  companyName        String       @map("company_name")
  email              String       @unique
  status             TenantStatus @default(PENDING)
  stripeCustomerId   String?      @map("stripe_customer_id")
  packageId          String?      @map("package_id") @db.Uuid
  packageAssignedAt  DateTime?    @map("package_assigned_at") @db.Timestamptz(6)
  minutesUsed        Int          @default(0) @map("minutes_used")
  creditBalanceCents Int          @default(0) @map("credit_balance_cents") // USD cents
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  package            Package?       @relation(fields: [packageId], references: [id])
  users              TenantUser[]
  agents             Agent[]
  phoneNumbers       PhoneNumber[]
  calls              Call[]
  creditLedger       CreditLedger[]
  payments           Payment[]
  invitations        TenantInvitation[]

  @@map("tenants")
}

enum TenantStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("tenant_status")
}

// ─── TENANT USERS ─────────────────────────────────────────────────────────────

model TenantUser {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  supabaseId   String         @unique @map("supabase_id") @db.Uuid // auth.users id
  email        String         @unique
  name         String
  type         TenantUserType
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_users")
}

enum TenantUserType {
  OWNER
  ACCOUNT_MANAGER

  @@map("tenant_user_type")
}

// ─── INVITATIONS ──────────────────────────────────────────────────────────────
// Owners inviting their own staff. Accepting produces a normal TenantUser row.

model TenantInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  email      String
  name       String
  type       TenantUserType   @default(ACCOUNT_MANAGER)
  /// sha256 of the invite token. The token itself is never stored.
  tokenHash  String           @unique @map("token_hash")
  invitedBy  String?          @map("invited_by")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

// ─── ADMIN USERS ─────────────────────────────────────────────────────────────

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  supabaseId  String    @unique @map("supabase_id") @db.Uuid // auth.users id
  email       String    @unique
  name        String
  role        AdminRole
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN

  @@map("admin_role")
}

// ─── AGENTS ──────────────────────────────────────────────────────────────────

model Agent {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  vapiAssistantId      String        @unique @map("vapi_assistant_id")
  name                 String
  status               AgentStatus   @default(ACTIVE)
  voice                String?
  model                String?
  systemPrompt         String?       @map("system_prompt")
  firstMessage         String?       @map("first_message")
  recordingEnabled     Boolean       @default(true) @map("recording_enabled")
  transcriptionEnabled Boolean       @default(true) @map("transcription_enabled")
  /// Extended Vapi options — see lib/vapi/config.ts. Server-side only.
  config               Json          @default("{}")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumbers         PhoneNumber[]
  calls                Call[]

  @@map("agents")
}

enum AgentStatus {
  ACTIVE
  INACTIVE

  @@map("agent_status")
}

// ─── PHONE NUMBERS ────────────────────────────────────────────────────────────

model PhoneNumber {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String?     @map("tenant_id") @db.Uuid // null = unallocated
  agentId           String?     @map("agent_id") @db.Uuid  // null = unassigned
  vapiPhoneNumberId String      @unique @map("vapi_phone_number_id")
  phoneNumber       String      @map("phone_number")
  status            PhoneStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agent             Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  calls             Call[]

  @@map("phone_numbers")
}

enum PhoneStatus {
  ACTIVE
  INACTIVE

  @@map("phone_status")
}

// ─── CALLS ───────────────────────────────────────────────────────────────────

model Call {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  agentId         String?       @map("agent_id") @db.Uuid
  phoneNumberId   String?       @map("phone_number_id") @db.Uuid
  vapiCallId      String        @unique @map("vapi_call_id")
  direction       CallDirection
  callerNumber    String?       @map("caller_number")
  durationSeconds Int           @default(0) @map("duration_seconds")
  minutesBilled   Int           @default(0) @map("minutes_billed") // ceiling of duration
  costCents       Int           @default(0) @map("cost_cents")     // USD cents
  status          CallStatus
  recordingUrl    String?       @map("recording_url")
  transcript      String?
  /// Model-written summary from the end-of-call report.
  summary         String?
  /// Why the call ended, verbatim from the provider.
  endedReason     String?       @map("ended_reason")
  /// Structured data extraction and success evaluation.
  analysis        Json?
  /// Turn-by-turn transcript with roles and timings.
  messages        Json?
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  agent           Agent?        @relation(fields: [agentId], references: [id])
  phoneNumber     PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])

  @@map("calls")
}

enum CallDirection {
  INBOUND
  OUTBOUND
  WEB

  @@map("call_direction")
}

enum CallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY

  @@map("call_status")
}

// ─── CREDIT LEDGER ────────────────────────────────────────────────────────────

model CreditLedger {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  type        LedgerEntryType
  amountCents Int             @map("amount_cents") // positive = credit, negative = debit
  description String?         // tenant-facing note — never contains staff identity
  referenceId String?         @map("reference_id") @db.Uuid // call id or payment id
  createdBy   String?         @map("created_by") // operator email; admin UI only
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id])

  @@map("credit_ledger")
}

enum LedgerEntryType {
  PACKAGE_PURCHASE
  TOP_UP
  CALL_DEDUCTION
  OVERAGE_CHARGE
  MANUAL_CREDIT
  MANUAL_DEDUCTION

  @@map("ledger_entry_type")
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  amountCents           Int           @map("amount_cents") // USD cents
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                Tenant        @relation(fields: [tenantId], references: [id])

  @@map("payments")
}

enum PaymentType {
  PACKAGE_PURCHASE
  TOP_UP

  @@map("payment_type")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("payment_status")
}

// ─── PLATFORM SETTINGS ────────────────────────────────────────────────────────
// Exactly one row, guarded by a boolean primary key with a CHECK constraint.

model PlatformSettings {
  id               Boolean  @id @default(true)
  overageRateCents Int      @default(35) @map("overage_rate_cents")
  lowBalancePct    Int      @default(20) @map("low_balance_pct")
  supportEmail     String   @default("support@hiastrix.com") @map("support_email")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?  @map("updated_by")

  @@map("platform_settings")
}
